# ATLAS-X environment template
# Copy to `.env` for local development. NEVER commit `.env`.
# Values here are safe placeholders/defaults. Production requires a real secret key.
# Backend reads variables with the ATLAS_ prefix via Settings.from_environ.

# Core
ATLAS_ENVIRONMENT=development
ATLAS_DATABASE_PATH=data/atlas.db

# Required non-empty when ATLAS_ENVIRONMENT=production
ATLAS_APPLICATION_SECRET_KEY=replace-with-a-long-random-value

# Authentication
ATLAS_AUTH_SESSION_TTL_MINUTES=60
ATLAS_AUTH_MAX_LOGIN_ATTEMPTS=5
ATLAS_AUTH_LOCKOUT_MINUTES=15
ATLAS_AUTH_FAILURE_DELAY_SECONDS=0.1

# Resource bounds (conservative laptop-safe defaults)
ATLAS_MAX_TASK_CHARS=4000
ATLAS_MAX_PLAN_STEPS=10
ATLAS_MAX_TOOL_CALLS=12
ATLAS_MAX_RECOVERY_ATTEMPTS=2
ATLAS_MAX_EXECUTION_SECONDS=120
ATLAS_MAX_SUBPROCESS_SECONDS=30
ATLAS_MAX_ARTIFACT_BYTES=10485760
ATLAS_MAX_INPUT_DATASET_BYTES=52428800
ATLAS_MAX_OUTPUT_CHARS=20000
ATLAS_MAX_LOG_BYTES=52428800
ATLAS_MAX_CONCURRENT_EXECUTIONS=1

# Sandbox confinement (WSL Ubuntu guest)
ATLAS_SANDBOX_DISTRIBUTION=Ubuntu-24.04
ATLAS_SANDBOX_MEMORY_MB=1024
ATLAS_SANDBOX_PIDS_MAX=256
ATLAS_SANDBOX_CPU_CORES=1.0
ATLAS_SANDBOX_MAX_OUTPUT_BYTES=1048576
ATLAS_SANDBOX_MAX_ARTIFACT_BYTES=16777216
ATLAS_SANDBOX_LAUNCHER_TIMEOUT_SECONDS=20

# Local model endpoint (loopback only)
ATLAS_MODEL_BASE_URL=http://127.0.0.1:11434
ATLAS_MODEL_NAME=llama3.1:8b
ATLAS_MODEL_TIMEOUT_SECONDS=300
ATLAS_MODEL_CONTEXT_TOKENS=4096
ATLAS_MODEL_MAX_PROMPT_CHARS=32000
ATLAS_MODEL_MAX_RESPONSE_BYTES=65536

# Optional host resource caps (leave unset to use process defaults)
# ATLAS_CPU_LIMIT_CORES=
# ATLAS_MEMORY_LIMIT_MB=

# CORS (not an ATLAS_ setting; read directly by the API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
